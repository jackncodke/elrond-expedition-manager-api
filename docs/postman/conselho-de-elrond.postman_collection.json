  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A API exige data de partida a partir de hoje. Calculamos uma data",
          "// futura a cada execucao para os exemplos nao envelhecerem.",
          "const daquiA = (dias) => {",
          "    const d = new Date();",
          "    d.setDate(d.getDate() + dias);",
          "    return d.toISOString().slice(0, 10);",
          "};",
          "",
          "pm.collectionVariables.set('data_partida', daquiA(45));",
          "pm.collectionVariables.set('data_partida_passada', daquiA(-1));"
        ]
      }
    }
