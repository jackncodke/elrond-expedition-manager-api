APP_NAME="Conselho de Elrond API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elrond_expedition_manager_db
DB_USERNAME=elrond_user
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Camada de rede do endpoint interno de decisao do conselho.
# Lista de IPs/faixas CIDR autorizados a chamar PATCH /api/expedicoes/{protocolo}/decisao
# Separados por virgula. Aceita IPv4, IPv6 e notacao CIDR.
# ---------------------------------------------------------------------------
INTERNAL_ALLOWED_IPS=127.0.0.1,::1,10.0.0.0/8

# ---------------------------------------------------------------------------
# Camada de token de servico do endpoint interno.
# Enviado pelo cliente no header X-Internal-Service-Token e comparado com hash_equals.
# Gere um valor aleatorio forte, por exemplo: php -r "echo bin2hex(random_bytes(32));"
# ---------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Validade do token do Sanctum emitido no login, em minutos, por tipo de usuario.
# O Conselho tem validade menor porque e o perfil que decide as expedicoes.
# Cada login revoga os tokens anteriores do mesmo usuario.
# ---------------------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION_REINO=480
SANCTUM_TOKEN_EXPIRATION_CONSELHO=120

# Prefixo dos protocolos gerados para as expedicoes (ex.: ELR-2026-000123)
EXPEDICAO_PROTOCOLO_PREFIXO=ELR

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
